# ---- GitHub login (OAuth) ------------------------------------
GITHUB_CLIENT_ID=Ov23liGNt9YEWRbdwV4v
GITHUB_CLIENT_SECRET=

# ---- Google login (optional) ---------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- E-mail (login links / notifications) --------------------
