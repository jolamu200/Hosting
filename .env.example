# ============================================================
#  Bmb Tech Hosting — ALL keys live here (no need to set them on the host)
#  Copy these same values to your host's env if it ignores .env files.
# ============================================================

# ---- Core -----------------------------------------------------
NODE_ENV=production
PORT=3000
SITE_URL=https://bmbtech.zone.id
CLIENT_URL=https://bmbtech.zone.id
FRONTEND_ORIGIN=https://bmbtech.zone.id
APP_NAME=Bmb Tech Hosting
IMAGE_URL=https://url.bmbxmd.workers.dev/KC0DC3.png

# REQUIRED: MongoDB Atlas connection string (Toxic's backend uses MongoDB, not Supabase)
MONGODB_URI=

# Auto-generated secrets (change them if you like, but keep them private)
JWT_SECRET=
SESSION_SECRET=

# ---- Admin ----------------------------------------------------
# REQUIRED: the e-mail of the super admin account (sign up with it, it becomes admin)
ADMIN_EMAIL=
ADMIN_USERNAME=bmbtech
ADMIN_PASSWORD=

# ---- Contacts shown on the site ------------------------------
SUPPORT_TELEGRAM=bmb_tech
SUPPORT_WHATSAPP=255767862457
WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029VawO6hgF6sn7k3SuVU3z
VITE_SUPPORT_EMAIL=

# ---- Heroku (bot deployment) ---------------------------------
HEROKU_API_KEY=
HEROKU_TEAM=alive

# ---- Default bot template (optional, seeded on first start) --
